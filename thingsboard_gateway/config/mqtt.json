{
  "broker": {
    "host": "34.173.180.125",
    "port": 1883,
    "clientId": "ThingsBoard_gateway",
    "version": 4,
    "maxMessageNumberPerWorker": 10,
    "maxNumberOfWorkers": 100,
    "sendDataOnlyOnChange": false,
    "cleanSession": true,
    "cleanStart": true,
    "sessionExpiryInterval": 0,
    "security": {
      "type": "basic",
      "username": "mqtt_user",
      "password": "admin1234"
    }
  },
  "mapping": [
    {
      "topicFilter": "cpv1/#",
      "subscriptionQos": 1,
      "converter": {
        "type": "json",
        "deviceInfo": {
          "deviceNameExpressionSource": "constant",
          "deviceNameExpression": "RawData",
          "deviceProfileExpressionSource": "constant",
          "deviceProfileExpression": "raw"
        },
        "sendDataOnlyOnChange": false,
        "timeout": 60000,
        "attributes": [
          {
            "type": "string",
            "key": "Weather Station Gateway Source",
            "value": "pele-ws-connector"
          }
        ],
        "timeseries": [
          {
            "type": "json",
            "key": "raw_weather_station_mqtt",
            "value": "${*}"
          }
        ]
      }
    }
  ],
  "id": "3c468af7-7880-4da0-8448-d7b36a5defa3"
}